# BullSharks.online Server Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/bullsharks_db

# Strava API Configuration
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_CLUB_ID=your_club_id

# Authentication
CRON_SECRET=your_cron_secret_for_populate_endpoint

# Server Configuration
PORT=8080
HOST=0.0.0.0

# Logging Configuration (optional)
RUST_LOG=info
# RUST_LOG=debug  # For more verbose logging
# RUST_LOG=bullsharks_server=debug,sqlx=info  # Selective logging

# Development flags (optional)
# DEVELOPMENT_MODE=true  # Enables additional development features